APP_DOMAIN=aicommander.example.org
APP_PORT=3000
APP_VERSION=9.5.0-stable
ALEMBIC_TARGET=head
# 联网构建区使用build；内网先导入全部同版镜像，再改为prebuilt。
DEPLOY_IMAGE_MODE=build
# v7+ 预构建模式要求离线交付清单；路径指向已验包目录，不填远程 URL。
OFFLINE_DELIVERY_MANIFEST=
OFFLINE_DELIVERY_ROOT=
# 文档导出与地图制包按实际能力启用；开启前准备相应运行镜像。
ENABLE_DOCUMENT_EXPORT=false
ENABLE_MAP_BUILD=false
# 管理员确认的自动更新厂区ID；留空关闭，最多16个，以逗号分隔。
MAP_AUTO_PUBLISH_AREA_IDS=
SECRETS_DIR=./secrets
BACKUP_DIR=./backups/postgres
DB_NAME=aicommander
# 已完成本机隔离演练的 PostGIS 16 镜像；目标架构须现场复验。
# 使用单位镜像仓库时保留经验证的 sha256 摘要，不得退回普通 PostgreSQL 镜像。
# v5.1+ 必须同时包含 PostGIS 和 pgvector；构建并离线导入后填不可变摘要。
# 支持 repository@sha256:<64 hex> 或本机 image ID sha256:<64 hex>。
# 参见 docs/local-history-embedding.zh-CN.md；禁止直接挂载旧 Alpine 数据卷。
POSTGIS_IMAGE=
ENABLE_LEGACY_PUBLIC_MAP_SYNC=false
ENABLE_LEGACY_EXTERNAL_GEO=false
ENABLE_LEGACY_PATROL_MATERIALIZATION=false
# 旧巡逻/人员/重点部位默认关闭；仅非生产历史环境可显式启用，生产配置始终禁止。
ENABLE_LEGACY_OPERATIONS_MODULES=false
MODEL_DATA_EGRESS_POLICY=local_only
TRUSTED_LOCAL_MODEL_HOSTS=localhost,127.0.0.1,::1
ENABLE_BONUS_ACCOUNTING=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 私有草稿：到期立即不可读，Beat 每小时清理；数据库备份单独按单位制度保管。
CASE_DRAFT_RETENTION_DAYS=7
CELERY_CONCURRENCY=2
# 修改 ENABLE_AGENT_LAB / AGENT_MODE 后须重启 Beat 和相关应用进程。
# 容器须重建实例加载新环境，不是仅 restart；详见 docs/runtime-feature-switches.zh-CN.md。
ENABLE_AGENT_LAB=false
# 留空继承旧查询开关；true/false 独立控制新查询，不影响历史读取与取消。
ENABLE_INTELLIGENT_QUERY=
# v4.2道路运行组合与专用队列；仅在相应镜像和路网准备完成后开启。
ENABLE_ROAD_ANALYSIS=false
ENABLE_SHOWCASE=false
AGENT_MODE=off
AGENT_MUTATIONS_ENABLED=false
AGENT_EXTERNAL_DATA_POLICY=redacted_only
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_REDIS_QUEUE=agent_lab
AGENT_PROVIDER=deterministic
AGENT_MODEL=
AGENT_MODEL_ID=
AGENT_MODEL_INPUT_COST_PER_MILLION_USD=0
AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=0
AGENT_USE_EXTERNAL_MODEL=false
AGENT_SDK_TRACING_ENABLED=false
AGENT_APPROVAL_TTL_HOURS=24
AGENT_MAP_PILOT_MAX_ASSETS=100
AGENT_CASE_PILOT_MAX_CASES=30
AGENT_DUAL_DOMAIN_PILOT_MAX_CASES=10
AGENT_DUAL_DOMAIN_PILOT_MAX_ASSETS=100

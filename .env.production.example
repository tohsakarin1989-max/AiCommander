APP_DOMAIN=aicommander.example.org
APP_PORT=3000
APP_VERSION=4.1.0-stable
ALEMBIC_TARGET=head
# 管理员确认的自动更新厂区ID；留空关闭，最多16个，以逗号分隔。
MAP_AUTO_PUBLISH_AREA_IDS=
SECRETS_DIR=./secrets
BACKUP_DIR=./backups/postgres
DB_NAME=aicommander
# 已完成本机隔离演练的 PostGIS 16 镜像；目标架构须现场复验。
# 使用单位镜像仓库时保留经验证的 sha256 摘要，不得退回普通 PostgreSQL 镜像。
POSTGIS_IMAGE=postgis/postgis:16-3.4-alpine@sha256:681931a625df344215e9b8998bf34daf146b6a395ceacee4439eb9c85869239f
ENABLE_LEGACY_PUBLIC_MAP_SYNC=false
ENABLE_LEGACY_EXTERNAL_GEO=false
ENABLE_LEGACY_PATROL_MATERIALIZATION=false
ENABLE_LEGACY_OPERATIONS_MODULES=false
MODEL_DATA_EGRESS_POLICY=local_only
TRUSTED_LOCAL_MODEL_HOSTS=localhost,127.0.0.1,::1
ENABLE_BONUS_ACCOUNTING=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
CELERY_CONCURRENCY=2
ENABLE_AGENT_LAB=false
ENABLE_SHOWCASE=false
AGENT_MODE=off
AGENT_MUTATIONS_ENABLED=false
AGENT_EXTERNAL_DATA_POLICY=redacted_only
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_REDIS_QUEUE=agent_lab
AGENT_PROVIDER=deterministic
AGENT_MODEL=
AGENT_MODEL_ID=
AGENT_MODEL_INPUT_COST_PER_MILLION_USD=0
AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=0
AGENT_USE_EXTERNAL_MODEL=false
AGENT_SDK_TRACING_ENABLED=false
AGENT_APPROVAL_TTL_HOURS=24
AGENT_MAP_PILOT_MAX_ASSETS=100
AGENT_CASE_PILOT_MAX_CASES=30
AGENT_DUAL_DOMAIN_PILOT_MAX_CASES=10
AGENT_DUAL_DOMAIN_PILOT_MAX_ASSETS=100

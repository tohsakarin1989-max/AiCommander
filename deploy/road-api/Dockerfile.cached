# Offline application update over a previously validated road + document runtime.
ARG ROAD_API_RUNTIME_IMAGE=aicommander-backend-roads:4.2-combined-candidate
FROM ${ROAD_API_RUNTIME_IMAGE} AS road-api
USER root
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
# Fail if dependencies changed; never silently fetch replacements in the intranet.
RUN python -m pip install --no-index --no-deps -r requirements.txt && python -m pip check
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini backend/docker-entrypoint.sh ./
COPY backend/document-renderer/map-render.mjs backend/document-renderer/render-docx.cjs ./document-renderer/
RUN chmod 0755 docker-entrypoint.sh && chmod -R a+rX app alembic && chmod a+r alembic.ini document-renderer/map-render.mjs
USER 10001:10001
RUN python -c "from valhalla import Actor; import playwright.sync_api; from alembic.config import Config; from alembic.script import ScriptDirectory; migrations = ScriptDirectory.from_config(Config('alembic.ini')); assert len(migrations.get_heads()) == 1; assert migrations.get_revision('b508c42fd75b') is not None; assert migrations.get_revision('v65r01') is not None; print('migration head:', migrations.get_current_head())" \
    && soffice --version && node --version
